--- a/Sources/AetherEngine/Video/LiveStuckClipWatch.swift
+++ b/Sources/AetherEngine/Video/LiveStuckClipWatch.swift
@@ -0,0 +1,35 @@
+import Foundation
+
+/// Some live origins get stuck: every connection sends the very same clip (seen on an Xtream restream of a live channel,
+/// the same 24 s, 100.1 s to 124.2 s on its own clock, every 20 s, for hours). Nothing can be shown live from
+/// such a copy; the host should switch to another one. This watch spots a source that restarts at the same
+/// point of its own clock again and again.
+public enum LiveStuckClip {
+    /// Called (any thread) when the playing live source keeps sending the same clip.
+    public static var onStuck: (@Sendable () -> Void)? {
+        get { lock.lock(); defer { lock.unlock() }; return _onStuck }
+        set { lock.lock(); _onStuck = newValue; lock.unlock() }
+    }
+    private static let lock = NSLock()
+    nonisolated(unsafe) private static var _onStuck: (@Sendable () -> Void)?
+}
+
+/// Pump-thread-only.
+struct LiveStuckClipWatch {
+    private var restarts: [Double] = []
+    private(set) var reported = false
+    /// The same restart point this many times in a row (with the first time) is a stuck source.
+    /// Twice at the same point: about 40 s of the clip, not two minutes.
+    static let repeatsToReport = 2
+    /// Within one frame is "the same point".
+    static let toleranceSeconds = 0.05
+
+    /// A backward jump of the source clock to `seconds` (a reconnect); true once the source counts as stuck.
+    mutating func restarted(atSeconds seconds: Double) -> Bool {
+        guard !reported else { return false }
+        if let last = restarts.last, abs(last - seconds) > Self.toleranceSeconds { restarts = [] }
+        restarts.append(seconds)
+        if restarts.count >= Self.repeatsToReport { reported = true }
+        return reported
+    }
+}
--- a/Sources/AetherEngine/Video/LiveTimestampRebaser.swift
+++ b/Sources/AetherEngine/Video/LiveTimestampRebaser.swift
@@ -0,0 +1,105 @@
+import CryptoKit
+import Foundation
+
+/// Some live origins resend the last stretch of media after every reconnect AND restart their
+/// clock from zero (seen with an Xtream restream: the second connection began with the previous
+/// connection's last ~20 s, byte for byte, timestamped from 1.46 s again). `LivePacketReplayGuard`
+/// proves a replay by matching timestamps and payloads, so a replay with a reset clock reached the
+/// screen a second time.
+///
+/// This rebaser puts such a source back on its own timeline before the guard looks at it: when a
+/// packet's timestamp jumps back and its payload is one already received, the source's clock is
+/// shifted so that packet gets its original timestamps back. From then on the guard sees an exact
+/// replay (same timestamps, same payload) and drops it, and the new media continues seamlessly.
+/// Without a payload match nothing changes: a real encoder restart keeps its own timestamps.
+///
+/// Pump-thread-only. Stores digests and times, never payloads; history is bounded.
+struct LiveTimestampRebaser {
+    enum Stream: Hashable { case video, audio }
+
+    private struct Key: Hashable {
+        let stream: Stream
+        let digest: SHA256.Digest
+    }
+
+    /// Seconds added to every source timestamp (0 until a replay with a reset clock is seen).
+    private(set) var offsetSeconds = 0.0
+    private var lastSeconds: [Stream: Double] = [:]
+    private var known: [Key: Double] = [:]
+    private var order: [(key: Key, seconds: Double)] = []
+    private var orderStart = 0
+    private var ambiguous: Set<Key> = []
+
+    private static let historySeconds = 60.0
+    private static let maximumEntries = 12_000
+    /// A jump back smaller than this is ordinary reordering, not a reconnect.
+    private static let backwardJumpSeconds = 1.0
+    private static let minimumPayloadBytes = 1_024
+
+    var isShifted: Bool { offsetSeconds != 0 }
+    /// Tests only: compare with the engine as it was.
+    nonisolated(unsafe) static var isEnabled = true
+    nonisolated(unsafe) static var debug = false
+
+    mutating func reset() {
+        offsetSeconds = 0
+        lastSeconds = [:]
+        known = [:]
+        order = []
+        orderStart = 0
+        ambiguous = []
+    }
+
+    /// Returns the timestamps the packet should carry (source time base), and whether this packet
+    /// just established a new shift.
+    mutating func rebase(stream: Stream, dts: Int64, pts: Int64, timeBaseSeconds: Double,
+                         payload: UnsafeRawBufferPointer) -> (dts: Int64, pts: Int64, shifted: Bool) {
+        guard Self.isEnabled, timeBaseSeconds > 0, dts != Int64.min else { return (dts, pts, false) }
+        let rawSeconds = Double(dts) * timeBaseSeconds
+        var seconds = rawSeconds + offsetSeconds
+        var shifted = false
+        // Only pictures prove a reset clock: audio frames (silence above all) repeat byte for byte in normal
+        // programmes. Small or repeated pictures prove nothing either.
+        let usable = stream == .video && payload.count >= Self.minimumPayloadBytes
+        let key = usable ? Key(stream: stream, digest: SHA256.hash(data: payload)) : nil
+        if Self.debug, let last = lastSeconds[stream], last - seconds > Self.backwardJumpSeconds {
+            EngineLog.emit("[LiveRebase] debug: \(stream) jumped back \(String(format: "%.2f", last - seconds)) s, size \(payload.count), usable \(usable), known \(key.map { known[$0] != nil } ?? false)", category: .session)
+        }
+        if let key, let last = lastSeconds[stream], last - seconds > Self.backwardJumpSeconds,
+           !ambiguous.contains(key), let original = known[key], abs(original - seconds) > Self.backwardJumpSeconds {
+            // A picture received before, now with an earlier clock: the clock was reset.
+            offsetSeconds = original - rawSeconds
+            seconds = original
+            shifted = true
+        }
+        let shift = Int64((offsetSeconds / timeBaseSeconds).rounded())
+        let newDts = dts + shift
+        let newPts = pts == Int64.min ? pts : pts + shift
+        if let key {
+            if let earlier = known[key] {
+                // The same picture twice in one timeline (a still, a test card): never evidence.
+                if abs(earlier - seconds) > Self.backwardJumpSeconds, !shifted { ambiguous.insert(key) }
+            } else {
+                known[key] = seconds
+                order.append((key, seconds))
+            }
+        }
+        lastSeconds[stream] = Swift.max(lastSeconds[stream] ?? seconds, seconds)
+        prune(newest: seconds)
+        return (newDts, newPts, shifted)
+    }
+
+    private mutating func prune(newest: Double) {
+        let cutoff = newest - Self.historySeconds
+        while orderStart < order.count,
+              order[orderStart].seconds < cutoff || order.count - orderStart > Self.maximumEntries {
+            let old = order[orderStart]
+            if known[old.key] == old.seconds { known.removeValue(forKey: old.key); ambiguous.remove(old.key) }
+            orderStart += 1
+        }
+        if orderStart > 2_048 {
+            order.removeFirst(orderStart)
+            orderStart = 0
+        }
+    }
+}
--- a/Tests/AetherEngineTests/LiveStuckClipWatchTests.swift
+++ b/Tests/AetherEngineTests/LiveStuckClipWatchTests.swift
@@ -0,0 +1,18 @@
+import XCTest
+@testable import AetherEngine
+
+final class LiveStuckClipWatchTests: XCTestCase {
+    func testSameRestartPointTwiceIsStuck() {
+        var watch = LiveStuckClipWatch()
+        XCTAssertFalse(watch.restarted(atSeconds: 100.1))
+        XCTAssertTrue(watch.restarted(atSeconds: 100.1))
+        XCTAssertFalse(watch.restarted(atSeconds: 100.1), "reported once")
+    }
+
+    func testRestartsAtNewPointsAreNotStuck() {
+        var watch = LiveStuckClipWatch()
+        XCTAssertFalse(watch.restarted(atSeconds: 100.1))
+        XCTAssertFalse(watch.restarted(atSeconds: 120.2))
+        XCTAssertFalse(watch.restarted(atSeconds: 140.3))
+    }
+}
--- a/Tests/AetherEngineTests/LiveTimestampRebaserTests.swift
+++ b/Tests/AetherEngineTests/LiveTimestampRebaserTests.swift
@@ -0,0 +1,61 @@
+import XCTest
+@testable import AetherEngine
+
+/// The pattern seen with an Xtream restream: after a reconnect the origin resends its last ~20 s byte for byte,
+/// with its clock restarted from 1.46 s.
+final class LiveTimestampRebaserTests: XCTestCase {
+    private let tb = 1.0 / 90_000
+
+    private func payload(_ n: Int) -> [UInt8] { Array("frame-\(n)".utf8) + [UInt8](repeating: UInt8(n % 251), count: 2_000) }
+
+    private func feed(_ r: inout LiveTimestampRebaser, _ n: Int, rawSeconds: Double) -> (Int64, Bool) {
+        let bytes = payload(n)
+        let dts = Int64((rawSeconds / tb).rounded())
+        return bytes.withUnsafeBytes { buf in
+            let out = r.rebase(stream: .video, dts: dts, pts: dts, timeBaseSeconds: tb, payload: buf)
+            return (out.dts, out.shifted)
+        }
+    }
+
+    func testReplayWithResetClockGetsItsOriginalTimestampsBack() {
+        var r = LiveTimestampRebaser()
+        // First connection: frames 0...3749 at 25 fps from 1.46 s (150 s).
+        var original: [Int: Int64] = [:]
+        for n in 0..<3750 {
+            let (dts, shifted) = feed(&r, n, rawSeconds: 1.46 + Double(n) / 25)
+            XCTAssertFalse(shifted)
+            original[n] = dts
+        }
+        // Second connection: the last 20 s again (frames 3250...), clock from 1.46 s, then new frames.
+        var shifts = 0
+        for k in 0..<1000 {
+            let n = 3250 + k
+            let (dts, shifted) = feed(&r, n, rawSeconds: 1.46 + Double(k) / 25)
+            if shifted { shifts += 1 }
+            if let o = original[n] { XCTAssertEqual(dts, o, "frame \(n) must get its original time back") }
+            else { XCTAssertGreaterThan(dts, original[3749]!, "new frames continue after the old ones") }
+        }
+        XCTAssertEqual(shifts, 1)
+    }
+
+    func testEncoderRestartWithNewPicturesKeepsItsOwnClock() {
+        var r = LiveTimestampRebaser()
+        for n in 0..<500 { _ = feed(&r, n, rawSeconds: 1.46 + Double(n) / 25) }
+        // New pictures (never seen) with a reset clock: nothing to align to.
+        let (dts, shifted) = feed(&r, 99_999, rawSeconds: 1.46)
+        XCTAssertFalse(shifted)
+        XCTAssertEqual(dts, Int64((1.46 / tb).rounded()))
+    }
+}
+
+extension LiveTimestampRebaserTests {
+    func testRepeatedStillPictureNeverShiftsTheClock() {
+        var r = LiveTimestampRebaser()
+        // The same picture at 10 s and at 20 s (a still): later seeing it again after a jump back proves nothing.
+        _ = feed(&r, 7, rawSeconds: 10)
+        _ = feed(&r, 1, rawSeconds: 15)
+        _ = feed(&r, 7, rawSeconds: 20)
+        let (_, shifted) = feed(&r, 7, rawSeconds: 2)
+        XCTAssertFalse(shifted)
+    }
+}
--- a/Tests/AetherEngineTests/RealResetClockReplayTests.swift
+++ b/Tests/AetherEngineTests/RealResetClockReplayTests.swift
@@ -0,0 +1,94 @@
+import Foundation
+import Testing
+@testable import AetherEngine
+
+/// Real recordings of an Xtream restream (not committed: paths come from AETHER_REPLAY_A / AETHER_REPLAY_B).
+/// B is the connection made right after A ended; it begins with A's last ~20 s byte for byte, its clock reset.
+@Suite("Real reset-clock replay", .serialized, .timeLimit(.minutes(5)))
+struct RealResetClockReplayTests {
+    private final class Reader: IOReader, @unchecked Sendable {
+        private let bytes: Data
+        private let lock = NSLock()
+        private var position = 0
+        init(_ bytes: Data) { self.bytes = bytes }
+        func read(_ buffer: UnsafeMutablePointer<UInt8>?, size: Int32) -> Int32 {
+            guard let buffer, size > 0 else { return -1 }
+            return lock.withLock {
+                let count = min(Int(size), bytes.count - position)
+                guard count > 0 else { return 0 }
+                bytes.withUnsafeBytes { _ = memcpy(buffer, $0.baseAddress! + position, count) }
+                position += count
+                return Int32(count)
+            }
+        }
+        func seek(offset: Int64, whence: Int32) -> Int64 { -1 }
+        func close() {}
+        var discImageProbeEnabled: Bool { false }
+    }
+
+    private final class Box: @unchecked Sendable {
+        let lock = NSLock()
+        var done = false
+        var rebases = 0
+    }
+
+    private func produce(_ bytes: Data, after predecessor: HLSSegmentProducer? = nil, cache shared: SegmentCache? = nil,
+                         keep: ((HLSSegmentProducer, SegmentCache) -> Void)? = nil) async throws -> (written: Int, rebases: Int) {
+        let demuxer = Demuxer()
+        try demuxer.open(reader: Reader(bytes), formatHint: "mpegts")
+        let index = demuxer.videoStreamIndex
+        let stream = try #require(demuxer.stream(at: index))
+        var audio: HLSSegmentProducer.AudioConfig?
+        if let s = demuxer.stream(at: demuxer.audioStreamIndex) {
+            audio = .init(codecpar: UnsafePointer(s.pointee.codecpar), timeBase: s.pointee.time_base,
+                          sourceStreamIndex: demuxer.audioStreamIndex, inputTimeBase: s.pointee.time_base,
+                          sourceTimeBase: s.pointee.time_base, bridge: nil, stripAacAdts: true)
+        }
+        let cache = shared ?? SegmentCache(forwardWindow: 400, backwardWindow: 400)
+        let producer = try HLSSegmentProducer(
+            demuxer: demuxer, videoStreamIndex: index,
+            video: .init(codecpar: UnsafePointer(stream.pointee.codecpar), timeBase: stream.pointee.time_base,
+                         codecTagOverride: "avc1"),
+            audio: audio, cache: cache, baseIndex: shared == nil ? 0 : cache.count, targetSegmentDurationSeconds: 2,
+            videoFallbackDurationPts: 3_600, desiredFirstVideoTfdtPts: shared == nil ? 0 : Int64(cache.count) * 180_000,
+            segmentBoundaries: [], isLive: true, bufferAheadSegments: 400)
+        if let predecessor { producer.continueLiveReplayHistory(from: predecessor) }
+        let box = Box()
+        producer.onPumpFinished = { reason in print("PUMP \(reason)"); box.lock.withLock { box.done = true } }
+        producer.onLiveTimelineRebase = { _, _ in box.lock.withLock { box.rebases += 1 } }
+        producer.onLiveSegmentFinalized = { _, _, _, _ in }
+        producer.start()
+        try await waitFor(upTo: .seconds(240)) { box.lock.withLock { box.done } }
+        let written = producer.packetsWrittenCount
+        if let keep { keep(producer, cache) } else { producer.stop() }
+        return (written, box.lock.withLock { box.rebases })
+    }
+
+    /// As the engine does it: the reset clock ends the first pump (`sourceReplay`), a fresh producer reads the
+    /// new connection and continues the first one's replay history.
+    private func reconnect(_ first: Data, _ second: Data) async throws -> Int {
+        var held: (HLSSegmentProducer, SegmentCache)?
+        _ = try await produce(first, keep: { held = ($0, $1) })
+        let (old, cache) = try #require(held)
+        let written = try await produce(second, after: old, cache: cache).written
+        old.stop()
+        return written
+    }
+
+    @Test func replayWithResetClockPlaysOnce() async throws {
+        let env = ProcessInfo.processInfo.environment
+        guard let a = env["AETHER_REPLAY_A"], let b = env["AETHER_REPLAY_B"],
+              let first = FileManager.default.contents(atPath: a),
+              let second = FileManager.default.contents(atPath: b) else { return }
+        EngineLog.handler = { line in
+            if line.contains("LiveRebase") || line.contains("pump finished") || line.contains("replay history") { print("LOG " + line.prefix(220)) }
+        }
+        let secondAlone = try await produce(second).written
+        LiveTimestampRebaser.isEnabled = false
+        let without = try await reconnect(first, second)
+        LiveTimestampRebaser.isEnabled = true
+        let with = try await reconnect(first, second)
+        print("REPLAY second connection alone=\(secondAlone) after reconnect: without fix=\(without) with fix=\(with)")
+        #expect(with < without - 500, "the repeated ~20 s must not be written again")
+    }
+}
